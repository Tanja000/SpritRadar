<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing Radar Sweep Sector (Top-Right Quadrant within safe zone) -->
    <path
        android:pathData="M 54,54 L 82,32 A 35,35 0 0,0 54,19 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="54"
                android:endX="78"
                android:endY="24"
                android:startColor="#8810B981"
                android:endColor="#1538BDF8"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Active Inner Radar Ring -->
    <path
        android:pathData="M 54,54 m -23,0 a 23,23 0 1,1 46,0 a 23,23 0 1,1 -46,0"
        android:strokeColor="#22D3EE"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />

    <!-- Radar Sweep Needle Line -->
    <path
        android:pathData="M 54,54 L 78,34"
        android:strokeColor="#4ADE80"
        android:strokeWidth="2.2" />

    <!-- Winding Route Highway Path at bottom -->
    <path
        android:pathData="M 32,76 Q 48,68 56,74 T 76,68"
        android:strokeColor="#38BDF8"
        android:strokeWidth="3.2"
        android:fillColor="#00000000" />

    <!-- Modern Fuel Pump Body (Left-Center inside safe zone) -->
    <path
        android:pathData="M 35,37 L 55,37 A 4,4 0 0,1 59,41 L 59,72 A 3,3 0 0,1 56,75 L 34,75 A 3,3 0 0,1 31,72 L 31,41 A 4,4 0 0,1 35,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="37"
                android:endX="59"
                android:endY="75"
                android:startColor="#38BDF8"
                android:endColor="#0284C7"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Pump Digital Price Display Window -->
    <path
        android:pathData="M 36,42 L 54,42 A 2,2 0 0,1 56,44 L 56,52 A 2,2 0 0,1 54,54 L 36,54 A 2,2 0 0,1 34,52 L 34,44 A 2,2 0 0,1 36,42 Z"
        android:fillColor="#082F49" />

    <!-- Green Best-Price Indicator Bars inside Pump Screen -->
    <path
        android:pathData="M 37,46 L 49,46 L 49,48.5 L 37,48.5 Z"
        android:fillColor="#4ADE80" />
    <path
        android:pathData="M 37,50 L 44,50 L 44,52 L 37,52 Z"
        android:fillColor="#38BDF8" />

    <!-- Golden Fuel Drop Emblem on Lower Pump Body -->
    <path
        android:pathData="M 45,57 C 45,57 50,63 50,66.5 A 5,5 0 1,1 40,66.5 C 40,63 45,57 45,57 Z"
        android:fillColor="#FACC15" />

    <!-- Fuel Hose & Nozzle (Right side of Pump) -->
    <path
        android:pathData="M 59,47 C 66,47 67,53 67,60 L 67,67 C 67,70 71,70 71,66 L 71,50 L 66,44"
        android:strokeColor="#E2E8F0"
        android:strokeWidth="3.0"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 67,44 L 62,40 L 62,46 Z"
        android:fillColor="#FACC15" />

    <!-- Glowing Green Radar Pin (Best-Price Station Target) -->
    <path
        android:pathData="M 70,31 m -7,0 a 7,7 0 1,1 14,0 a 7,7 0 1,1 -14,0"
        android:fillColor="#16A34A" />
    <path
        android:pathData="M 70,31 m -5.2,0 a 5.2,5.2 0 1,1 10.4,0 a 5.2,5.2 0 1,1 -10.4,0"
        android:fillColor="#4ADE80" />
    <path
        android:pathData="M 70,31 m -2.3,0 a 2.3,2.3 0 1,1 4.6,0 a 2.3,2.3 0 1,1 -4.6,0"
        android:fillColor="#FFFFFF" />
</vector>
